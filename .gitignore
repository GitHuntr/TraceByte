# ---------------------------------------------------------------------------
# TraceByte — Signature Carving Evaluation Workbench
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments (Windows)
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Pytest scratch output files dropped in the project root
.pytest-output-*.txt

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Secrets (never commit evidence credentials)
.env
*.pem
*.key

# --- Forensic data directories -------------------------------------------
# data/originals/ is INTENTIONALLY TRACKED IN GIT.
# It holds the ground-truth synthetic fixtures and manifest.json, which is the
# baseline evidence record. Tracking it means a reviewer can independently
# re-verify the baseline hashes against the committed files.
#
# Runtime evidence, experiment output and logs are local workspaces and are
# therefore excluded from version control.

data/experiments/*
!data/experiments/.gitkeep

data/evidence/*
!data/evidence/.gitkeep

data/recovered/*
!data/recovered/.gitkeep

logs/*.jsonl
!logs/.gitkeep

reports/*.md
reports/*.csv
reports/*.json
!reports/.gitkeep
!reports/TraceByte_Final_Report.md
!reports/TraceByte_Presentation_and_Viva_Prep.md
!reports/TraceByte_Final_Report.pdf
